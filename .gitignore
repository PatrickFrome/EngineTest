# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =============================================================================
# Node.js / Next.js
# =============================================================================
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build cache (regenerated automatically)
/.next/
/out/

# production build
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (contain secrets — NEVER commit)
.env
.env.*
!.env.example
local-*
.claude
.z-ai-config

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# server logs
*.log
dev.log
dev.out.log
server.log

# =============================================================================
# MetaEngine — large artifacts (kept locally, excluded from git)
# =============================================================================
# 649 MB of source archives — kept locally, NOT pushed (regeneratable from
# GitHub lineage anchors .path/.sha256 which ARE committed)
METAENGINE_SLICE3_RESTORED/lineages/engine_*/Destruktion_*/
METAENGINE_RESTORED/04_LINEAGES/

# 233 MB old restore archive (kept for provenance, not committed)
METAENGINE_RESTORED/

# Old slice4 checkpoint zip (4.5 MB) — kept locally, not committed
METAENGINE_CHECKPOINT_SLICE4_COMPLETE_*.zip

# Benchmark run outputs (large JSON dumps — sync'd to Turso cloud DB instead)
METAENGINE_SLICE3_RESTORED/storage/massive_benchmark_tasks*/
METAENGINE_SLICE3_RESTORED/storage/phase*/
METAENGINE_SLICE3_RESTORED/storage/*.nohup.out
METAENGINE_SLICE3_RESTORED/storage/*.pid
METAENGINE_SLICE3_RESTORED/storage/evidence_graph.json
METAENGINE_SLICE3_RESTORED/storage/engine_biographies.json
METAENGINE_SLICE3_RESTORED/storage/mechanism_library.json
METAENGINE_SLICE3_RESTORED/storage/events.log
METAENGINE_SLICE3_RESTORED/storage/typed_state_cache/
METAENGINE_SLICE3_RESTORED/storage/phase32_side/

# SQLite local databases
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Python caches
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Adaptation patches (generated by analyze_and_improve.py — reviewed manually)
METAENGINE_SLICE3_RESTORED/metaengine/adaptation_patches/

# LangGraph checkpoint DBs (transient)
METAENGINE_SLICE3_RESTORED/**/langgraph*.sqlite
METAENGINE_SLICE3_RESTORED/**/checkpoint*.sqlite

# =============================================================================
# Skills directory (z-ai SDK)
# =============================================================================
/skills/METAENGINE_SLICE3_RESTORED/.env.local

# =============================================================================
# Tool outputs and uploads
# =============================================================================
tool-results/
upload/
download/
.zscripts/

# =============================================================================
# Mini-services build artifacts
# =============================================================================
mini-services/*/node_modules/
mini-services/*/.next/
mini-services/*/dist/
