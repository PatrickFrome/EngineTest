{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "16X Adaptive Arbitration 1.2",
  "type": "object",
  "required": [
    "arbitration_version",
    "decision_count",
    "decisions",
    "followup_portfolio",
    "policy",
    "arbitration_hash",
    "hybrid_followup_portfolio"
  ],
  "properties": {
    "arbitration_version": {
      "const": "16X-ADAPTIVE-ARBITRATION-1.2"
    },
    "decision_count": {
      "type": "integer",
      "minimum": 0
    },
    "decisions": {
      "type": "array"
    },
    "followup_portfolio": {
      "type": "array"
    },
    "policy": {
      "type": "object",
      "required": [
        "majority_is_not_truth",
        "material_dissent_blocks_promotion"
      ]
    },
    "arbitration_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "hybrid_followup_portfolio": {
      "type": "array"
    }
  },
  "additionalProperties": true
}