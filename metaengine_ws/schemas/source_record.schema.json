{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaengine.local/schemas/source_record.schema.json",
  "title": "MetaEngine METAENGINE-1-SLICE-3 Architecture Source Record",
  "type": "object",
  "required": [
    "registry_version", "source_id", "publisher", "system_name", "version",
    "source_class", "official_source_locator", "exact_commit_or_release",
    "retrieved_at", "license_name", "allowed_use", "architecture_claims",
    "retained_reference_paths", "mechanism_candidates", "ingestion", "source_hash"
  ],
  "properties": {
    "registry_version": {"const": "METAENGINE-SOURCE-REGISTRY-1"},
    "source_id": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "system_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_class": {"enum": ["PERMISSIVE_CODE", "RESTRICTED_REFERENCE", "CLOSED_BEHAVIORAL_ONLY"]},
    "official_source_locator": {"type": "string", "minLength": 1},
    "exact_commit_or_release": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "license_name": {"type": "string", "minLength": 1},
    "license_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "allowed_use": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "architecture_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "evidence_kind", "evidence_refs"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "evidence_kind": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "retained_reference_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "mechanism_candidates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "ingestion": {"enum": ["OBSERVED", "UNOBSERVED"]},
    "ingestion_blocker": {
      "type": ["object", "null"],
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "UNOBSERVED"},
        "reason": {"type": "string", "minLength": 1},
        "detail": {"type": ["string", "null"]}
      }
    },
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"source_class": {"const": "CLOSED_BEHAVIORAL_ONLY"}}},
      "then": {"properties": {"retained_reference_paths": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"ingestion": {"const": "OBSERVED"}}},
      "then": {
        "required": ["source_sha256"],
        "properties": {"source_sha256": {"type": "string"}, "ingestion_blocker": {"type": "null"}}
      }
    },
    {
      "if": {"properties": {"ingestion": {"const": "UNOBSERVED"}}},
      "then": {
        "required": ["ingestion_blocker"],
        "properties": {"source_sha256": {"type": "null"}}
      }
    }
  ]
}
