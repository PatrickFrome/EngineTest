{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaengine.local/schemas/evolution_campaign.schema.json",
  "title": "MetaEngine 2.3 controlled evolution campaign",
  "type": "object",
  "required": ["campaign_version", "generation_count", "total_parallel_worlds", "maximum_concurrent_worlds", "generations", "final_active_policy", "invariants", "campaign_hash"],
  "properties": {
    "campaign_version": {"const": "16X-CONTROLLED-SELF-LEARNING-2.3"},
    "generation_count": {"type": "integer", "minimum": 1},
    "total_parallel_worlds": {"type": "integer", "minimum": 1},
    "maximum_concurrent_worlds": {"type": "integer", "minimum": 1},
    "generations": {"type": "array", "items": {"type": "object", "required": ["generation", "champion_before", "champion_after", "disposition", "world_count", "freeze_hash", "decision_hash"], "additionalProperties": true}},
    "final_active_policy": {"type": "object"},
    "invariants": {"type": "object"},
    "campaign_hash": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "additionalProperties": true
}
