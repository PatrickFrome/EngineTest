{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/argument_bundle.schema.json",
  "title": "Destruktion argument graph bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "bundle_id", "claims", "arguments", "issues"],
  "properties": {
    "bundle_version": {"const": "DAE-ARGUMENT-1.0"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "status", "claim_type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["STATED", "ACCEPTED", "REJECTED", "QUESTIONED"]},
          "claim_type": {"enum": ["INFORMATION", "ASSUMPTION", "EXCEPTION"]},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scheme_id", "direction", "conclusion", "premises", "critical_questions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,63}$"},
          "scheme_id": {"type": "string", "minLength": 1},
          "direction": {"enum": ["PRO", "CON"]},
          "conclusion": {"type": "string", "minLength": 1},
          "premises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "role"],
              "properties": {
                "claim_id": {"type": "string", "minLength": 1},
                "role": {"enum": ["ORDINARY", "ASSUMPTION", "EXCEPTION"]}
              }
            }
          },
          "critical_questions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "status": {"enum": ["ANSWERED", "OPEN", "NOT_APPLICABLE"]},
                "answer": {"type": "string"},
                "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
              }
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "proof_standard", "burden_party"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "proof_standard": {"enum": ["SCINTILLA", "DIALECTICAL"]},
          "burden_party": {"type": "string", "minLength": 1},
          "declared_status": {"enum": ["SUPPORTED", "REJECTED", "CONTESTED", "UNSUPPORTED", "SUSPENDED"]}
        }
      }
    }
  }
}
