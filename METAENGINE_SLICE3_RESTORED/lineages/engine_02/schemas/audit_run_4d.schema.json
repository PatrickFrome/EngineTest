{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/automation/audit-run-4d-0.1.json",
  "title": "DAE Branch 4D Audit Run 0.1",
  "type": "object",
  "required": ["run_id", "branch_id", "engine_version", "core_version", "execution"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "branch_id": {"const": "4D"},
    "engine_version": {"const": "0.2.3-alpha.1"},
    "core_version": {"const": "CORE 4.0.0-alpha.1"},
    "description": {"type": "string"},
    "execution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "record_id", "module_id", "phase", "scope", "bridge_status"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "record_id": {"type": "string", "minLength": 1},
          "record_path": {"type": "string", "minLength": 1},
          "module_id": {"enum": ["MA4", "GE4", "BS4", "TO4"]},
          "phase": {"enum": ["RECONSTRUCTION", "HYPOTHESIS", "DISCRIMINATION", "COUNTERPROFILE", "FINALIZATION"]},
          "scope": {"enum": ["LOCAL", "REGIONAL", "EPOCHAL", "UNIVERSAL", "UNRESOLVED"]},
          "bridge_status": {"enum": ["EXPLICIT", "CONTESTED", "ABSENT", "UNRESOLVED"]},
          "decision_note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
