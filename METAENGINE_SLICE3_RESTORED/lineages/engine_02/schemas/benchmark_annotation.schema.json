{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/benchmark_annotation.schema.json",
  "title": "Destruktion independent benchmark annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotation_version", "benchmark_id", "manifest_sha256", "packet_sha256", "coder", "completed_at", "units", "claim_ceiling"],
  "properties": {
    "annotation_version": {"const": "DAE-EXPERT-ANNOTATION-1.0"},
    "benchmark_id": {"type": "string", "pattern": "^BENCH-[A-F0-9]{16}$"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "coder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "independent_of_system_development", "blinded_to_predictions", "source_access_attested", "conflicts_disclosed"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,63}$"},
        "role": {"const": "INDEPENDENT_DOMAIN_ANNOTATOR"},
        "independent_of_system_development": {"const": true},
        "blinded_to_predictions": {"const": true},
        "source_access_attested": {"const": true},
        "conflicts_disclosed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "completed_at": {"type": "string", "format": "date-time"},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "status", "confidence", "evidence_refs", "rationale"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^BU-[A-F0-9]{16}$"},
          "status": {"$ref": "#/$defs/status"},
          "confidence": {"type": "integer", "minimum": 1, "maximum": 3},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "rationale": {"type": "string", "minLength": 20}
        }
      }
    },
    "claim_ceiling": {"const": "INDEPENDENT_CODER_JUDGMENT_NOT_ADJUDICATED_GOLD"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["SUPPORTED", "QUALIFIED", "REJECTED", "INSUFFICIENT"]}
  }
}
