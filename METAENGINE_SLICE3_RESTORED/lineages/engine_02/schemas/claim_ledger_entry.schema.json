{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/claim_ledger_entry.schema.json",
  "title": "Destruktion claim ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "selector", "origin", "claim_type", "scale", "apb", "rt_candidates", "operative_relation_status", "strongest_rival", "revision_condition", "status", "replaces", "supersedes", "depends_on", "decision_history", "claim_ceiling"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^CLM-[A-F0-9]{8}-AR-U[0-9]{6}-[A-F0-9]{10}$"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argument_segment_id", "member_segment_ids", "normalized_sha256"],
      "properties": {
        "argument_segment_id": {"type": "string", "pattern": "^AR-U"},
        "member_segment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^OX-P"}},
        "normalized_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_layer", "routing_status", "routing_confidence", "human_attested"],
      "properties": {
        "candidate_layer": {"enum": ["SOURCE", "RECONSTRUCTION", "PROJECT_CLAIM", "RIVAL_OBJECTION", "PROTOCOL_TOOL_LOG", "UNRESOLVED"]},
        "routing_status": {"enum": ["ROUTED", "TENTATIVE", "AMBIGUOUS"]},
        "routing_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "human_attested": {"const": false}
      }
    },
    "claim_type": {"enum": ["SOURCE_PASSAGE", "RECONSTRUCTION", "PROJECT_ASSERTION", "OBJECTION", "QUESTION", "CONCLUSION", "PROTOCOL_ACTIVITY", "UNRESOLVED_ASSERTION"]},
    "scale": {"enum": ["LOCAL", "WORK", "DIACHRONIC", "EPOCHAL", "UNIVERSAL", "UNRESOLVED"]},
    "apb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "P", "B", "status"],
      "properties": {
        "A": {"type": ["string", "null"]},
        "P": {"type": ["string", "null"]},
        "B": {"type": ["string", "null"]},
        "status": {"const": "NOT_RECONSTRUCTED"}
      }
    },
    "rt_candidates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RT(?:0[0-9]|1[0-9]|2[0-8])$"}},
    "operative_relation_status": {"const": "UNADJUDICATED"},
    "strongest_rival": {"type": ["object", "null"]},
    "revision_condition": {"type": "string", "minLength": 1},
    "status": {"enum": ["UNADJUDICATED", "ARCHIVED_DUPLICATE", "ARCHIVED_TOOL_LOG"]},
    "replaces": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "decision_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "timestamp", "agent", "basis"],
        "properties": {
          "event": {"const": "MACHINE_ROUTED_FOR_REVIEW"},
          "timestamp": {"type": "string", "format": "date-time"},
          "agent": {"const": "dae-corpus-refinery"},
          "basis": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "claim_ceiling": {"const": "CLAIM_CANDIDATE_WITHOUT_APB_RECONSTRUCTION_OR_SEMANTIC_PROMOTION"}
  }
}
