{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/operator_regression_manifest.schema.json",
  "title": "Destruktion operator cross-corpus regression manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "regression_version",
    "candidate_operator",
    "corpora",
    "claim_ceiling"
  ],
  "properties": {
    "regression_version": {"const": "DAE-OPERATOR-REGRESSION-MANIFEST-1.0"},
    "candidate_operator": {"type": "string", "minLength": 3},
    "description": {"type": "string"},
    "corpora": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corpus_id",
          "label",
          "control_role",
          "refinery_directory",
          "living_analysis_file",
          "expected_mutation",
          "expected_profile_hints",
          "rationale"
        ],
        "properties": {
          "corpus_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "label": {"type": "string", "minLength": 1},
          "control_role": {
            "enum": ["ORIGIN_POSITIVE", "TRANSFER_POSITIVE", "MIXED_CONTROL", "NEGATIVE_CONTROL"]
          },
          "refinery_directory": {"type": "string", "minLength": 1},
          "living_analysis_file": {"type": "string", "minLength": 1},
          "expected_mutation": {"type": "boolean"},
          "expected_profile_hints": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim_ceiling": {
      "const": "INTERNAL_CROSS_CORPUS_OPERATOR_REGRESSION_NOT_EXTERNAL_PHILOSOPHICAL_VALIDATION"
    }
  }
}
