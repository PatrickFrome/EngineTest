{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/benchmark_manifest.schema.json",
  "title": "Destruktion frozen expert benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_version", "engine_version", "generated_at", "benchmark_id", "task", "codebook", "source_cycles", "units", "evaluation_plan", "blinding", "claim_ceiling"],
  "properties": {
    "benchmark_version": {"const": "DAE-EXPERT-BENCHMARK-1.0"},
    "engine_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "benchmark_id": {"type": "string", "pattern": "^BENCH-[A-F0-9]{16}$"},
    "task": {"const": "EXPERT_THESIS_STATUS"},
    "codebook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codebook_id", "labels", "decision_rule"],
      "properties": {
        "codebook_id": {"const": "DAE-EXPERT-STATUS-1.0"},
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["SUPPORTED", "QUALIFIED", "REJECTED", "INSUFFICIENT"],
          "properties": {
            "SUPPORTED": {"type": "string", "minLength": 1},
            "QUALIFIED": {"type": "string", "minLength": 1},
            "REJECTED": {"type": "string", "minLength": 1},
            "INSUFFICIENT": {"type": "string", "minLength": 1}
          }
        },
        "decision_rule": {"type": "string", "minLength": 1}
      }
    },
    "source_cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "source_id", "artifact_sha256", "profile_id", "profile_sha256", "expert_cycle_sha256", "expert_cycle_version", "engine_version", "snapshot_file"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "profile_id": {"type": "string", "minLength": 1},
          "profile_sha256": {"$ref": "#/$defs/sha256"},
          "expert_cycle_sha256": {"$ref": "#/$defs/sha256"},
          "expert_cycle_version": {"type": "string", "minLength": 1},
          "engine_version": {"type": "string", "minLength": 1},
          "snapshot_file": {"type": "string", "pattern": "^source_cycles/[A-Z0-9_-]+\\.expert_cycle\\.json$"}
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    },
    "evaluation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_before_labels", "minimum_units", "minimum_gold_per_label", "independent_coders_min", "agreement", "promotion", "fixed_baselines", "bootstrap_iterations", "seed"],
      "properties": {
        "frozen_before_labels": {"const": true},
        "minimum_units": {"type": "integer", "minimum": 80},
        "minimum_gold_per_label": {"type": "integer", "minimum": 20},
        "independent_coders_min": {"type": "integer", "minimum": 2},
        "agreement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alpha_min", "alpha_ci_lower_min"],
          "properties": {
            "alpha_min": {"type": "number", "minimum": -1, "maximum": 1},
            "alpha_ci_lower_min": {"type": "number", "minimum": -1, "maximum": 1}
          }
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["macro_f1_min", "macro_f1_ci_lower_min", "improvement_over_best_fixed_baseline_min", "dangerous_overpromotion_rate_max", "decision_ece_max"],
          "properties": {
            "macro_f1_min": {"type": "number", "minimum": 0, "maximum": 1},
            "macro_f1_ci_lower_min": {"type": "number", "minimum": 0, "maximum": 1},
            "improvement_over_best_fixed_baseline_min": {"type": "number", "minimum": 0, "maximum": 1},
            "dangerous_overpromotion_rate_max": {"type": "number", "minimum": 0, "maximum": 1},
            "decision_ece_max": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "fixed_baselines": {
          "const": ["ALWAYS_INSUFFICIENT", "ALWAYS_QUALIFIED"]
        },
        "bootstrap_iterations": {"type": "integer", "minimum": 500, "maximum": 10000},
        "seed": {"type": "string", "minLength": 1}
      }
    },
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predictions_stored_separately", "packets_exclude_status_and_confidence", "source_access_required", "system_developers_ineligible_as_independent_coders", "gold_frozen_before_unblinding"],
      "properties": {
        "predictions_stored_separately": {"const": true},
        "packets_exclude_status_and_confidence": {"const": true},
        "source_access_required": {"const": true},
        "system_developers_ineligible_as_independent_coders": {"const": true},
        "gold_frozen_before_unblinding": {"const": true}
      }
    },
    "claim_ceiling": {"const": "FROZEN_BLIND_EVALUATION_PLAN_NOT_EMPIRICAL_VALIDATION"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "run_id", "source_id", "artifact_sha256", "thesis_id", "title", "statement", "scale", "source_access_required", "candidate_evidence_selectors"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^BU-[A-F0-9]{16}$"},
        "run_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "thesis_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "scale": {"enum": ["DOCUMENT", "LOCAL", "WORK", "DIACHRONIC", "EPOCHAL", "UNIVERSAL", "METHOD"]},
        "source_access_required": {"const": true},
        "candidate_evidence_selectors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
