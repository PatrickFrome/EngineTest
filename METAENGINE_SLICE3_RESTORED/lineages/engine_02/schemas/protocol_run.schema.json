{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/protocol_run.schema.json",
  "title": "Destruktion declarative protocol run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_version", "run_id", "protocol_id", "protocol_version", "subject", "operator", "started_at", "mode", "answers"],
  "properties": {
    "run_version": {"const": "DAE-PROTOCOL-RUN-1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "protocol_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "role"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["NORMAL", "ARCHIVAL_REVIEW"]},
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {"enum": ["YES", "NO", "UNKNOWN", "NA"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "note": {"type": "string"},
          "reviewed_by": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "declared_outcome": {"enum": ["PASS", "REVIEW", "SUSPEND", "FAIL"]},
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "reason"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "impact": {"type": "string"}
        }
      }
    }
  }
}
