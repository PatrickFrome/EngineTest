{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/source_map.schema.json",
  "title": "Destruktion corpus source map",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_map_version", "engine_version", "generated_at", "document_source_id", "document_artifact", "catalog_targets", "ga_volume_candidates", "unresolved_marker_clusters", "coverage", "claim_ceiling"],
  "properties": {
    "source_map_version": {"const": "DAE-SOURCE-MAP-1.0"},
    "engine_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "document_source_id": {"type": "string", "minLength": 3},
    "document_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "role", "admission"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "role": {"const": "COMPOSITE_CONTAINER"},
        "admission": {"enum": ["CATALOGUED", "LOCAL_HASH"]}
      }
    },
    "catalog_targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "ga_volume_candidates": {"type": "array", "items": {"$ref": "#/$defs/gaVolume"}},
    "unresolved_marker_clusters": {"type": "array", "items": {"$ref": "#/$defs/marker"}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments_scanned", "segments_with_catalog_alias", "segments_with_ga_locator", "pseudo_citation_occurrences", "hyperlink_occurrences", "resolved_claim_level_citations"],
      "properties": {
        "segments_scanned": {"type": "integer", "minimum": 0},
        "segments_with_catalog_alias": {"type": "integer", "minimum": 0},
        "segments_with_ga_locator": {"type": "integer", "minimum": 0},
        "pseudo_citation_occurrences": {"type": "integer", "minimum": 0},
        "hyperlink_occurrences": {"type": "integer", "minimum": 0},
        "resolved_claim_level_citations": {"const": 0}
      }
    },
    "claim_ceiling": {"const": "SOURCE_TARGET_AND_CITATION_MARKER_CANDIDATES_ONLY_NOT_CLAIM_LEVEL_SOURCE_RESOLUTION"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_source_id", "catalog_kind", "resolution_status", "evidence_basis", "mention_count", "selectors", "selectors_truncated", "human_review_required"],
      "properties": {
        "catalog_source_id": {"type": "string", "minLength": 1},
        "catalog_kind": {"type": "string", "minLength": 1},
        "resolution_status": {"const": "LEXICAL_ALIAS_CANDIDATE"},
        "evidence_basis": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "mention_count": {"type": "integer", "minimum": 1},
        "selectors": {"type": "array", "items": {"type": "string", "pattern": "^OX-P"}},
        "selectors_truncated": {"type": "boolean"},
        "human_review_required": {"const": true}
      }
    },
    "gaVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume", "mention_count", "selectors", "resolution_status"],
      "properties": {
        "volume": {"type": "integer", "minimum": 1, "maximum": 105},
        "mention_count": {"type": "integer", "minimum": 1},
        "selectors": {"type": "array", "items": {"type": "string", "pattern": "^OX-P"}},
        "resolution_status": {"const": "VOLUME_LOCATOR_ONLY"}
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_sha256", "occurrence_count", "selectors", "resolution_status"],
      "properties": {
        "marker_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "occurrence_count": {"type": "integer", "minimum": 1},
        "selectors": {"type": "array", "items": {"type": "string", "pattern": "^OX-P"}},
        "resolution_status": {"const": "UNRESOLVED_PSEUDO_CITATION"}
      }
    }
  }
}
