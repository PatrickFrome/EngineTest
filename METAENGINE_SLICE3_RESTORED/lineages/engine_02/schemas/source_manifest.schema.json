{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/source_manifest.schema.json",
  "title": "Destruktion page-aware source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "source_id",
    "bibliographic",
    "artifact",
    "extracted_text",
    "pagination",
    "access_policy",
    "crosswalk"
  ],
  "properties": {
    "manifest_version": {"const": "DAE-SOURCE-MANIFEST-1.0"},
    "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "bibliographic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "title", "publication", "year", "language", "source_url"],
      "properties": {
        "author": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publication": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": -9999, "maximum": 9999, "not": {"const": 0}},
        "volume": {"type": "string", "minLength": 1},
        "printed_pages": {"type": "string", "minLength": 1},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
        "source_url": {"type": "string", "format": "uri"},
        "genre": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "byte_length", "sha256"],
      "properties": {
        "media_type": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "extracted_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "byte_length", "sha256", "method", "page_delimiter"],
      "properties": {
        "media_type": {"const": "text/plain"},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "method": {"type": "string", "minLength": 1},
        "page_delimiter": {"const": "FORM_FEED"},
        "normalization": {"type": "string", "minLength": 1}
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "labels"],
      "properties": {
        "scheme": {"enum": ["PRINTED_PAGE", "DIGITAL_PAGE", "CANVAS"]},
        "authority": {"enum": ["SOURCE_AUTHORED", "PRINTED_ARTIFACT", "RENDERER_DERIVED", "PLATFORM_DERIVED"]},
        "labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_class", "raw_text_retention", "redistribution", "allow_derived_outputs", "basis"],
      "properties": {
        "analysis_class": {"enum": ["REFERENCE_ONLY", "DERIVATIVE_ONLY", "REUSABLE_TEXT"]},
        "raw_text_retention": {"enum": ["TRANSIENT", "PROJECT", "RELEASE"]},
        "redistribution": {"enum": ["NOT_AUTHORIZED", "UNKNOWN", "AUTHORIZED"]},
        "allow_derived_outputs": {"type": "boolean"},
        "basis": {"type": "string", "minLength": 1},
        "restrictions_checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_edition", "status", "target_locator", "evidence_refs"],
      "properties": {
        "target_edition": {"type": "string", "minLength": 1},
        "status": {"enum": ["NONE", "WORK_LEVEL_CONFIRMED", "PAGE_LEVEL_PARTIAL", "PAGE_LEVEL_CONFIRMED"]},
        "target_locator": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "note": {"type": "string"}
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drop_line_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "analyze_notes": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"access_policy": {"properties": {"analysis_class": {"const": "REFERENCE_ONLY"}}}}},
      "then": {"properties": {"access_policy": {"properties": {"allow_derived_outputs": {"const": false}}}}}
    },
    {
      "if": {"properties": {"access_policy": {"properties": {"analysis_class": {"const": "DERIVATIVE_ONLY"}}}}},
      "then": {"properties": {"access_policy": {"properties": {"raw_text_retention": {"const": "TRANSIENT"}}}}}
    }
  ]
}
