{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/micro_local_operator_ecology_manifest.schema.json",
  "title": "Destruktion micro-local operator ecology manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["ecology_version", "corpus_id", "competition_manifest_file", "competition_result_file", "segmentation_manifest_file", "windows", "boundaries", "scoring", "synthesis", "claim_ceiling"],
  "properties": {
    "ecology_version": {"const": "DAE-MICRO-LOCAL-OPERATOR-ECOLOGY-MANIFEST-1.0"},
    "description": {"type": "string"},
    "corpus_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "competition_manifest_file": {"type": "string", "minLength": 1},
    "competition_result_file": {"type": "string", "minLength": 1},
    "segmentation_manifest_file": {"type": "string", "minLength": 1},
    "windows": {
      "type": "array", "minItems": 3, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["window_id", "label", "evidence_segment_ids", "profile_hints", "expected_decision", "expected_selected_candidates", "rationale"],
        "properties": {
          "window_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "label": {"type": "string", "minLength": 1},
          "evidence_segment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "profile_hints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "expected_decision": {"enum": ["SELECT_LOCAL_WINNER", "LOCAL_COMPOSITION", "KEEP_RIVALS_UNRESOLVED", "ABSTAIN_UNRESOLVED"]},
          "expected_selected_candidates": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z0-9_-]+$"}, "uniqueItems": true},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "boundaries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["boundary_id", "left_window_id", "right_window_id", "expected_status"],
        "properties": {
          "boundary_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "left_window_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "right_window_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "expected_status": {"enum": ["CONTINUOUS_LOCAL_REGIME", "PRESERVE_OPERATOR_BOUNDARY", "UNRESOLVED_BOUNDARY"]}
        }
      }
    },
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["dominance_margin", "composition_gain_threshold"],
      "properties": {
        "dominance_margin": {"type": "integer", "minimum": 1, "maximum": 10},
        "composition_gain_threshold": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "synthesis": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_decision"],
      "properties": {
        "expected_decision": {"enum": ["REJECT_GLOBAL_COLLAPSE_PRESERVE_WINDOW_PROVENANCE", "ALLOW_LOCAL_SINGLE_OPERATOR_SYNTHESIS"]}
      }
    },
    "claim_ceiling": {"const": "INTERNAL_PREREGISTERED_MICRO_LOCAL_ROUTING_NOT_EXTERNAL_SEMANTIC_VALIDATION"}
  }
}
