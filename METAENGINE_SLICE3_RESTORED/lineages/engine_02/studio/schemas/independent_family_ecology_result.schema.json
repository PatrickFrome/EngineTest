{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/studio/independent_family_ecology_result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_version",
    "engine_version",
    "generated_at",
    "outcome",
    "routing_policy",
    "promotion_status",
    "source",
    "candidate_births",
    "windows",
    "boundaries",
    "synthesis",
    "provenance_graph",
    "preregistration",
    "summary",
    "claim_ceiling"
  ],
  "properties": {
    "result_version": {
      "const": "DAE-MICRO-LOCAL-ECOLOGY-RESULT-1.0"
    },
    "engine_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "PASSES_MICRO_LOCAL_ECOLOGY_REGRESSION",
        "FAILS_MICRO_LOCAL_ECOLOGY_REGRESSION"
      ]
    },
    "routing_policy": {
      "const": "ARGUMENT_WINDOW_SELECTION_COMPOSITION_BOUNDARY_OR_ABSTENTION_WITH_POLYPHONIC_SYNTHESIS_GATE"
    },
    "promotion_status": {
      "const": "EXPERIMENTAL_NOT_CORE"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_id",
        "label",
        "source_docx_sha256",
        "windowing_mode",
        "include_layers",
        "raw_text_included"
      ],
      "properties": {
        "corpus_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source_docx_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "windowing_mode": {
          "type": "string"
        },
        "include_layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw_text_included": {
          "const": false
        }
      }
    },
    "candidate_births": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "origin_corpus_id",
          "origin_operator_candidate",
          "origin_profile_hints",
          "required_birth_hints",
          "missing_birth_hints",
          "origin_mutation_found",
          "source_birth_confirmed"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "origin_corpus_id": {
            "type": "string"
          },
          "origin_operator_candidate": {
            "type": "string"
          },
          "origin_profile_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_birth_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_birth_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origin_mutation_found": {
            "type": "boolean"
          },
          "source_birth_confirmed": {
            "type": "boolean"
          }
        }
      }
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "window_id",
          "heading",
          "paragraph_segment_ids",
          "paragraph_hashes",
          "source_operator_candidate",
          "operator_family",
          "active_signal_families",
          "signal_counts",
          "profile_hints",
          "candidate_evaluations",
          "decision",
          "selected_candidates",
          "covered_hints",
          "residual_hints",
          "expectation_pass",
          "checks"
        ],
        "properties": {
          "window_id": {
            "pattern": "^MW-\\d{3}$"
          },
          "heading": {
            "type": "string"
          },
          "paragraph_segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paragraph_hashes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "decision": {
            "enum": [
              "SELECT_LOCAL_WINNER",
              "LOCAL_COMPOSITION",
              "KEEP_RIVALS_UNRESOLVED",
              "ABSTAIN_UNRESOLVED"
            ]
          },
          "selected_candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectation_pass": {
            "type": "boolean"
          }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundary_id",
          "from_window_id",
          "to_window_id",
          "boundary_type",
          "from_signature",
          "to_signature",
          "unresolved"
        ],
        "properties": {
          "boundary_id": {
            "pattern": "^MB-\\d{3}$"
          },
          "from_window_id": {
            "type": "string"
          },
          "to_window_id": {
            "type": "string"
          },
          "boundary_type": {
            "enum": [
              "OPERATOR_REGIME_SHIFT",
              "PARTIAL_OPERATOR_OVERLAP",
              "OPEN_BOUNDARY",
              "STABLE_LOCAL_REGIME"
            ]
          },
          "from_signature": {
            "type": "string"
          },
          "to_signature": {
            "type": "string"
          },
          "unresolved": {
            "type": "boolean"
          }
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "global_selected_candidates",
        "local_signatures",
        "heterogeneity_preserved",
        "rationale",
        "expectation_pass",
        "expected_decision"
      ],
      "properties": {
        "decision": {
          "enum": [
            "PRESERVE_POLYPHONIC_LOCALITY",
            "SINGLE_LOCAL_REGIME_AVAILABLE"
          ]
        },
        "global_selected_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "local_signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heterogeneity_preserved": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        },
        "expectation_pass": {
          "type": "boolean"
        },
        "expected_decision": {
          "type": "string"
        }
      }
    },
    "provenance_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "raw_text_included"
      ],
      "properties": {
        "nodes": {
          "type": "array"
        },
        "edges": {
          "type": "array"
        },
        "raw_text_included": {
          "const": false
        }
      }
    },
    "preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_expected_headings",
        "unexpected_observed_headings"
      ],
      "properties": {
        "missing_expected_headings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unexpected_observed_headings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidates",
        "source_births_confirmed",
        "windows",
        "expected_windows",
        "expectations_passed",
        "distinct_local_signatures",
        "boundaries",
        "unresolved_boundaries",
        "abstentions",
        "unresolved_rivals",
        "unserved_windows"
      ]
    },
    "claim_ceiling": {
      "const": "MICRO_LOCAL_ROUTING_AND_SYNTHESIS_FIDELITY_TEST_NOT_EXTERNAL_SEMANTIC_VALIDATION_OR_CORE_PROMOTION"
    }
  }
}
