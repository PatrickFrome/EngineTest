{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/schemas/external_system_predictions.schema.json",
  "type": "object",
  "required": ["predictions_version", "campaign_id", "benchmark_id", "system", "independence", "generated_at", "predictions", "claim_ceiling"],
  "properties": {
    "predictions_version": {"const": "DESTRUKTION-EXTERNAL-SYSTEM-PREDICTIONS-1.0"},
    "campaign_id": {"type": "string"},
    "benchmark_id": {"type": "string"},
    "system": {
      "type": "object",
      "required": ["system_id", "kind", "name", "model_or_version", "protocol_id"],
      "properties": {
        "system_id": {"type": "string", "minLength": 3},
        "kind": {"enum": ["FRONTIER_LLM_BASELINE", "SCHOLARLY_PROMPT_BASELINE", "HUMAN_EXPERT_BASELINE", "OTHER_EXTERNAL_SYSTEM"]},
        "name": {"type": "string", "minLength": 1},
        "model_or_version": {"type": "string", "minLength": 1},
        "protocol_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "independence": {
      "type": "object",
      "required": ["independent_of_dae_development", "dae_outputs_seen", "gold_seen", "benchmark_annotations_seen", "system_prompt_contains_dae_output"],
      "properties": {
        "independent_of_dae_development": {"const": true},
        "dae_outputs_seen": {"const": false},
        "gold_seen": {"const": false},
        "benchmark_annotations_seen": {"const": false},
        "system_prompt_contains_dae_output": {"const": false}
      },
      "additionalProperties": false
    },
    "generated_at": {"type": "string", "minLength": 1},
    "predictions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "status", "confidence"],
        "properties": {
          "unit_id": {"type": "string"},
          "status": {"enum": ["SUPPORTED", "QUALIFIED", "REJECTED", "INSUFFICIENT"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "claim_ceiling": {"type": "string"}
  },
  "additionalProperties": false
}
