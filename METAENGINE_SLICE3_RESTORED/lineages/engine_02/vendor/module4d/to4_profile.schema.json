{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/module/to4-0.1-engine-reconstruction.json",
  "title": "TO4-0.1 Technical-Organizational Ordering Profile — engine reconstruction",
  "type": "object",
  "required": ["module_id", "version", "system", "mode", "goals_functions", "ordering_dimensions", "criteria_tradeoffs", "human_roles", "governance", "control_responsibility", "value_status", "corrigibility", "heideggerian_fit", "discriminator", "revision_trigger"],
  "properties": {
    "module_id": {"const": "TO4"},
    "version": {"const": "0.1-engine-reconstruction"},
    "system": {"type": "string", "minLength": 1},
    "mode": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["DESIGN", "OPERATION", "INFRASTRUCTURE", "AI", "SCIENTIFIC_TECHNOLOGY", "ORGANIZATION", "OTHER", "UNRESOLVED"]}
    },
    "goals_functions": {"type": "string", "minLength": 1},
    "ordering_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["CALCULATION", "OPTIMIZATION", "STANDARDIZATION", "SCALING", "ALLOCATION", "MONITORING", "PREDICTION", "AUTOMATION", "CONTROL", "OTHER", "UNRESOLVED"]}
    },
    "criteria_tradeoffs": {"type": "string", "minLength": 1},
    "human_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "governance": {"type": "string", "minLength": 1},
    "control_responsibility": {"type": "string", "minLength": 1},
    "value_status": {"enum": ["NEUTRALITY_CLAIM", "VALUE_LADEN_FUNCTION", "VALUE_SENSITIVE_DESIGN", "MIXED", "CONTESTED", "UNRESOLVED"]},
    "corrigibility": {"type": "string", "minLength": 1},
    "heideggerian_fit": {"enum": ["NONE", "PARTIAL", "STRONG", "TOTAL_CLAIM_REQUIRES_REVIEW", "UNRESOLVED"]},
    "discriminator": {"type": "string", "minLength": 1},
    "revision_trigger": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
