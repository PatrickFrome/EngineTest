{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destruktion.local/module/ge4-0.1-engine-reconstruction.json",
  "title": "GE4-0.1 Gestell / Enframing Profile — engine reconstruction",
  "type": "object",
  "required": ["module_id", "version", "disclosure_mode", "ordering_signature", "human_position", "target_domain", "alternative_disclosure", "totalization_status", "danger_status", "counterprofile", "discriminator", "revision_trigger"],
  "properties": {
    "module_id": {"const": "GE4"},
    "version": {"const": "0.1-engine-reconstruction"},
    "disclosure_mode": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["CHALLENGING_FORTH", "ORDERING", "SECURING_AVAILABILITY", "CALCULATIVE_FORECASTING", "OTHER", "UNRESOLVED"]}
    },
    "ordering_signature": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["AVAILABILITY", "ORDERABILITY", "SUBSTITUTABILITY", "CALCULABILITY", "SECURING", "STANDARDIZATION", "CHAINED_DEMAND", "OPTIMIZATION", "OTHER", "UNRESOLVED"]}
    },
    "human_position": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["CHALLENGER", "CHALLENGED_PARTICIPANT", "QUALIFIED_RESERVE_PIECE", "NOT_MERE_RESERVE", "CONTESTED", "UNRESOLVED"]}
    },
    "target_domain": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "alternative_disclosure": {"type": "string", "minLength": 1},
    "totalization_status": {"enum": ["LOCAL_FIT", "REGIONAL_FIT", "EPOCHAL_SOURCE_CLAIM", "PLANETARY_SOURCE_CLAIM", "UNIVERSAL_META_CLAIM", "CONTESTED", "UNRESOLVED"]},
    "danger_status": {"enum": ["RESTRICTED", "EPOCHAL", "DANGER_SAVING_AMBIGUITY", "CONTESTED", "UNRESOLVED"]},
    "counterprofile": {"type": "string", "minLength": 1},
    "discriminator": {"type": "string", "minLength": 1},
    "revision_trigger": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
