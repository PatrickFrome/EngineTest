{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Destruktion Studio",
      "program": "${workspaceFolder}/studio/studio.mjs",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "DAE CLI help",
      "program": "${workspaceFolder}/bin/destruktion.mjs",
      "args": ["--help"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
