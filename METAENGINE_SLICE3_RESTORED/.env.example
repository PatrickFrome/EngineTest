# METAENGINE — Environment Variables Template

# Turso Cloud DB (for cross-run persistence)
TURSO_DB_TOKEN=your_turso_db_token_here
TURSO_DB_HOST=metaengine-project-patrickfrome.aws-eu-west-1.turso.io

# LLM Bridge
LLM_BRIDGE_API_KEY=

# MetaEngine API
METAENGINE_ROOT=/app
METAENGINE_PORT=8080

# Next.js Dashboard
NODE_OPTIONS=--max-old-space-size=512
