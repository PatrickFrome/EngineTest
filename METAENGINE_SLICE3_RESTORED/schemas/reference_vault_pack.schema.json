{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaengine.local/schemas/reference_vault_pack.schema.json",
  "title": "MetaEngine Reference Vault Source Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_schema_version",
    "source_id",
    "exact_commit_or_release",
    "blob_descriptors",
    "pack_root_sha256"
  ],
  "properties": {
    "pack_schema_version": {"const": "ARCHITECTURE-SOURCE-PACK-1"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "exact_commit_or_release": {"type": "string", "minLength": 1},
    "blob_descriptors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blobDescriptor"}
    },
    "pack_root_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "blobDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "digest_algorithm",
        "digest",
        "size",
        "relative_path",
        "git_blob_id"
      ],
      "properties": {
        "media_type": {"type": "string", "minLength": 1},
        "digest_algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "git_blob_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
          ]
        }
      }
    }
  }
}
