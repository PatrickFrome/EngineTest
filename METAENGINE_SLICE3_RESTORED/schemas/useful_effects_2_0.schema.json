{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Useful Effects 2.0",
  "type": "object",
  "required": [
    "effects_version",
    "effects",
    "metrics",
    "claim_ceiling",
    "effects_hash"
  ],
  "properties": {
    "effects_version": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "effect_id",
          "present",
          "strength_score",
          "epistemic_status"
        ],
        "properties": {
          "effect_id": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "strength_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "epistemic_status": {
            "type": "string"
          },
          "engine_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "effects_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "additionalProperties": false
}
